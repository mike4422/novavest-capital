# Public app URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email provider: resend or smtp
EMAIL_PROVIDER=resend
EMAIL_FROM="NovaVest Capital <noreply@novavestcapital.com>"
ADMIN_EMAIL=admin@novavestcapital.com
RESEND_API_KEY=re_xxxxxxxxx

# SMTP fallback
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@novavestcapital.com
SMTP_PASS=your-smtp-password

# Cron security
CRON_SECRET=change-this-long-random-secret
